    {
      "name": "Workspace Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "const allWorkspaces = Array.isArray(responseData.workspaces) ? responseData.workspaces : [];",
              "const currentWorkspaceId = Number(pm.collectionVariables.get('workspaceId'));",
              "const currentPropertyId = Number(pm.collectionVariables.get('propertyId'));",
              "",
              "let selectedWorkspace = allWorkspaces.find(workspace => Number(workspace.workspaceIndex) === currentWorkspaceId && Number(workspace.propertyIndex) === currentPropertyId);",
              "",
              "if (!selectedWorkspace) {",
              "    selectedWorkspace = allWorkspaces.find(workspace => Number(workspace.workspaceIndex) === currentWorkspaceId);",
              "}",
              "",
              "if (!selectedWorkspace && allWorkspaces.length > 0) {",
              "    selectedWorkspace = allWorkspaces[0];",
              "}",
              "",
              "if (selectedWorkspace) {",
              "    pm.collectionVariables.set('workspaceId', String(selectedWorkspace.workspaceIndex || selectedWorkspace.id));",
              "    pm.collectionVariables.set('propertyId', String(selectedWorkspace.propertyIndex));",
              "",
              "    if (selectedWorkspace.ownerEmail) {",
              "        pm.collectionVariables.set('workspaceOwnerEmail', selectedWorkspace.ownerEmail);",
              "    }",
              "",
              "    if (selectedWorkspace.type) {",
              "        pm.collectionVariables.set('workspaceType', selectedWorkspace.type);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/workspaces",
          "host": [
            "{{baseUrl}}"
          ],
