    {
      "name": "Add Workspace",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();",
              "",
              "if (responseData.workspace) {",
              "    const workspaceId = responseData.workspace.workspaceIndex || responseData.workspace.id;",
              "",
              "    if (workspaceId) {",
              "        pm.collectionVariables.set('workspaceId', String(workspaceId));",
              "    }",
              "",
              "    if (responseData.workspace.type) {",
              "        pm.collectionVariables.set('workspaceType', responseData.workspace.type);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
